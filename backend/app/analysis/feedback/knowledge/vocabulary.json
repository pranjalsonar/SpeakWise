{
  "filler_alternatives": {
    "um": ["a silent pause", "a slow breath before the next phrase"],
    "uh": ["a silent pause", "a slow breath before the next phrase"],
    "er": ["a silent pause"],
    "hm": ["a silent pause", "\"Let me think about that\""],
    "ah": ["a silent pause"],
    "like": ["a short pause", "\"for example\" (when giving an example)", "\"such as\""],
    "you know": ["a short pause", "\"as you can see\"", "\"consider this\""],
    "i mean": ["\"in other words\"", "\"to put it simply\""],
    "you see": ["\"notice that\"", "a short pause"],
    "basically": ["\"in short\"", "leave it out"],
    "actually": ["\"in fact\"", "leave it out"],
    "literally": ["leave it out", "a more precise word"],
    "obviously": ["leave it out", "\"clearly\" (only if it truly is)"],
    "honestly": ["leave it out", "\"to be direct\""],
    "so": ["\"First,\" / \"Next,\" / \"Finally,\"", "a short pause"],
    "well": ["a short pause", "\"Let me explain\""],
    "right": ["a short pause", "\"Now\""],
    "okay": ["a short pause", "\"Now\""]
  },
