PROJECT_NAME=SpeakWise
VERSION=1.0.0
ENVIRONMENT=development

HOST=127.0.0.1
PORT=8999

# PostgreSQL connection string.
# Special characters in the password must be URL-encoded (e.g. "@" -> "%40").
DATABASE_URL=postgresql+psycopg2://speakwise_app:speakwise%401234@localhost:5432/speakwise_db

# JWT signing secret (at least 32 characters). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWTSECRET_KEY=your_jwt_secret_key
JWT_ALGORITHM=HS256
# How long an access token stays valid, in hours.
JWT_EXPIRE_HOURS=8