PROJECT_NAME=SpeakWise
VERSION=1.0.0
ENVIRONMENT=development

HOST=127.0.0.111
PORT=8999

# PostgreSQL connection string.
# Special characters in the password must be URL-encoded (e.g. "@" -> "%40").
DATABASE_URL=postgresql+psycopg2://speakwise_app:speakwise%401234@localhost:5432/speakwise_db

# JWT signing secret (at least 32 characters). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWTSECRET_KEY=your_jwt_secret_key
JWT_ALGORITHM=HS256
# How long an access token stays valid, in hours.
JWT_EXPIRE_HOURS=8

# Timezone for dashboard periods like "this week" / "this month".
REPORTING_TIMEZONE=Asia/Kolkata

# Comma-separated frontend URLs allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Topics & reading material (Wikipedia). See docs/TOPICS_READING_DESIGN.md.
# Wikimedia asks every API client to identify itself with a contact URL or email.
WIKIPEDIA_USER_AGENT=SpeakWise/1.0 (https://github.com/pranjalsonar/SpeakWise; contact: you@example.com)
WIKI_CACHE_DAYS=30
READING_TARGET_WORDS=2500
READING_MAX_VERSIONS=5
CUSTOM_TOPICS_PER_HOUR=10