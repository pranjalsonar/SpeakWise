# Copy to .env and adjust. Restart `npm run dev` after changing.
# Everything here is bundled into the browser app, so never put secrets in it.

# FastAPI backend base URL (no trailing slash).
# To test from a phone on your LAN, use your PC's LAN IP, e.g. http://192.168.1.20:8999
VITE_API_BASE_URL=http://127.0.0.1:8999

# Route prefix for versioned API endpoints (matches backend settings.API_PREFIX).
VITE_API_PREFIX=/api/v1

# Abort API requests that take longer than this (milliseconds).
VITE_API_TIMEOUT_MS=15000
