{
  "name": "speakwise-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "SpeakWise desktop demo: records a session and hands it to the Colab pipeline via Google Drive.",
  "main": "main.cjs",
  "scripts": {
    "build:ui": "npm --prefix ../frontend run build:desktop",
    "start": "npm run build:ui && node scripts/run.cjs",
    "start:only": "node scripts/run.cjs",
    "test": "node --test \"test/*.test.cjs\"",
    "smoke": "node scripts/run.cjs --smoke",
    "shots": "npm run build:ui && node scripts/run.cjs --shots"
  },
  "devDependencies": {
    "electron": "^44.7.0"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  }
}
